MONGODB_CONNECTION='mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app>'
MONGODB_DATABASE='minutes_generator_db'

# Signs login tokens. Changing it logs everyone out.
JWT_SECRET="your_jwt_secret_key"

# Encrypts stored API keys. Changing it makes saved keys unreadable.
ENCRYPTION_KEY="your_encryption_key_for_api_keys"
SALT="minutes-generator-salt-v1"

# Where the React app finds the API
REACT_APP_API_BASE_URL="http://localhost:3001/api"

# Optional: Groq retires models often, override without a code change
# GROQ_MODEL="openai/gpt-oss-120b"
# Optional: local Whisper size (tiny, base, small, medium, large-v3)
# WHISPER_MODEL="small"

# CORS allowed origins for production (comma-separated, no spaces)
# Local network IPs (192.168.x.x, 10.x.x.x, etc.) are automatically allowed
# Example: CORS_ORIGINS="https://minutes.pavlodev.com"
CORS_ORIGINS=""
